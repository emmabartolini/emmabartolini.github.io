---
import { t, langNames, LANGS, type Lang } from '../i18n/translations';
import { switchLang } from '../i18n/utils';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const navLinks = [
  { key: 'nav.design' as const, href: `/${lang}/design/` },
  { key: 'nav.writing' as const, href: `/${lang}/writing/` },
  { key: 'nav.education' as const, href: `/${lang}/education/` },
  { key: 'nav.about' as const, href: `/${lang}/about/` },
];
---

<header class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-ink/10">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href={`/${lang}/`} class="block">
        <img src="/logo.svg" alt="Emma" class="h-7 w-auto" />
      </a>

    <nav class="hidden md:flex items-center gap-8">
      {navLinks.map(({ key, href }) => (
        <a
          href={href}
          class:list={[
            'font-serif text-sm transition-opacity duration-200',
            { 'opacity-40': currentPath !== href }
          ]}
          style="letter-spacing: -0.04em;"
        >
          {t(lang, key)}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      {LANGS.map((l) => (
        <a
          href={switchLang(currentPath, l)}
          class:list={[
            'font-serif text-xs transition-opacity duration-200',
            l === lang ? 'opacity-100' : 'opacity-30 hover:opacity-70'
          ]}
          style="letter-spacing: 0.05em;"
        >
          {langNames[l]}
        </a>
      ))}

      <button
          id="menu-toggle"
          class="md:hidden ml-4"
          aria-label="Menu"
        >
          <img src="/menu-icon.svg" alt="" class="h-6 w-auto" />
        </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-ink/10">
    <nav class="max-w-7xl mx-auto px-6 py-6 flex flex-col gap-4">
      {navLinks.map(({ key, href }) => (
        <a href={href} class="font-serif text-xl" style="letter-spacing: -0.06em;">
          {t(lang, key)}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
